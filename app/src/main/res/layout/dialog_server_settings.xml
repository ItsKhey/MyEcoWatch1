<?xml version="1.0" encoding="utf-8"?>
<!--
    Lets the developer point the app at a different EcoWatch server without
    rebuilding it.

    The compiled-in address is the normal case, so this is deliberately a small,
    separate screen rather than something embedded in the login form. The address
    is the one part of a local-server setup that cannot be known until the day:
    the laptop's DHCP address changes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Where the EcoWatch server is running"
        android:textColor="@color/green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColorHint="@color/green"
        app:boxStrokeColor="@color/green_input_color"
        app:hintTextColor="@color/green">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/serverAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="192.168.1.11:5000"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/green" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/serverStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="13sp" />

    <!--
        Searches the phone's own subnet for a running EcoWatch server.

        This is the escape hatch for the case the typed field cannot help with:
        the laptop joined a different network and now has a different address, and
        you are holding the phone rather than the laptop. One read-only GET per
        host, within the phone's own /24 only.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/findServerBtn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Find server on this network"
        android:textColor="@color/green"
        app:strokeColor="@color/green" />

    <TextView
        android:id="@+id/scanStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="The scheme, port and /api path are optional and are filled in for you. Leave the host blank to go back to the address this app was built with."
        android:textColor="#A0A0A0"
        android:textSize="12sp" />
</LinearLayout>
