<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MyEcoWatchApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="33"
        android:theme="@style/Theme.MyEcoWatch1">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            App Link for the emailed links. Both registration verification and
            password reset continue at the same https path, because that is the one
            continue URL the backend hands Firebase; the mode query parameter tells
            this activity which screen to open.

            autoVerify only succeeds once this app's signing certificate SHA-256 is
            registered in the Firebase console, because that is what Firebase
            Hosting serves at /.well-known/assetlinks.json for the project. Without
            it Android falls back to showing a chooser, which still works, so a
            missing SHA is a UX degradation rather than a breakage.

            The custom-scheme filters on the two screens below are kept as a
            fallback: point FIREBASE_CONTINUE_URL at ecowatch://password-reset and
            the flow works even with no Hosting site and no registered SHA.
        -->
        <activity
            android:name=".ui.auth.EmailActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.MyEcoWatch1">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="ecowatch1-4445f.firebaseapp.com"
                    android:pathPrefix="/finishSignUp"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
            Deep link target for the password-reset email.

            This is the custom-scheme fallback path. The scheme must match
            FIREBASE_CONTINUE_URL on the backend if that fallback is in use, and
            the scheme has to be listed as an authorized domain in the Firebase
            console or Firebase refuses to generate the link. The intent only
            carries an opaque oobCode; the password itself is decided by the
            backend, never by this activity.
        -->
        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="password-reset"
                    android:scheme="ecowatch" />
            </intent-filter>
        </activity>

        <!--
            Deep link target for the registration verification email. Opening it
            brings the resident back to the "I have verified" screen so they never
            have to hunt for the app manually.
        -->
        <activity
            android:name=".ui.auth.EmailVerificationActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="email-verified"
                    android:scheme="ecowatch" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.DashboardActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.example.myecowatch1.action.OPEN_NOTIFICATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/UCropTheme" />

        <service
            android:name=".notifications.EcoWatchFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>