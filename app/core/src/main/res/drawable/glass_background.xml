<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Green Glass Base / Outline -->
    <item>
        <shape>
            <solid android:color="#1A0B3D2E" />

            <stroke
                android:width="2dp"
                android:color="@color/green" />

            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Inner Transparent Glass -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>
            <gradient
                android:startColor="#35FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="270" />

            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Top Glossy Reflection -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="55dp">

        <shape>
            <gradient
                android:startColor="#AAFFFFFF"
                android:centerColor="#45FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />

            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>

    <!-- Bottom Glass Reflection -->
    <item
        android:left="3dp"
        android:top="75dp"
        android:right="3dp"
        android:bottom="3dp">

        <shape>
            <gradient
                android:startColor="#00FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#35A8FFB0"
                android:angle="270" />

            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>

    <!-- Subtle Green Inner Glow -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>
            <solid android:color="#001B5E20" />

            <stroke
                android:width="1dp"
                android:color="#4090FF90" />

            <corners android:radius="8dp" />
        </shape>
    </item>

</layer-list>