<?xml version="1.0" encoding="utf-8"?>
<!--
  Night variant of the status pill. The day version uses a pale green fill
  with a dark green outline, which would glow against the dark surface, so the
  colours are swapped for the dark palette.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1B3B25" />
    <corners android:radius="100dp" />
    <stroke
        android:width="1dp"
        android:color="@color/green" />
</shape>