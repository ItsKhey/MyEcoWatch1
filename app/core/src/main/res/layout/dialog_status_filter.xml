<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Filter by Status"
            android:textColor="@color/green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnResetStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_reset"
                app:tint="@color/green" />

            <ImageButton
                android:id="@+id/btnBackStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/green" />
        </LinearLayout>
    </RelativeLayout>

    <RadioGroup
        android:id="@+id/statusRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioStatusAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="@color/green"
            android:buttonTint="@color/green"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/radioStatusPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textColor="@color/green"
            android:buttonTint="@color/green"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/radioStatusCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completed"
            android:textColor="@color/green"
            android:buttonTint="@color/green"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/radioStatusDenied"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Denied"
            android:textColor="@color/green"
            android:buttonTint="@color/green"
            android:padding="8dp"/>
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyStatusFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Apply Filter"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"/>

</LinearLayout>
