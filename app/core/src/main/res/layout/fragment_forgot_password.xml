<?xml version="1.0" encoding="utf-8"?>
<!--
    Forgot Password.

    Only one step remains here. The resident supplies the email on their account
    and the backend emails a Firebase reset link; tapping that link is what opens
    ResetPasswordActivity, where the new password is actually set. There is no code
    to type and no code field, because the emailed link is the proof.

    The field is the account's email, not its username. The resident never names
    the account being reset: the link identifies it, and the backend resolves it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/forgotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Forgot Password"
            android:textColor="@color/green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Step 1: request the link -->
        <LinearLayout
            android:id="@+id/methodContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/forgotInstructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Enter the email address on your account and we will send you a link to choose a new password."
                android:textColor="@color/green"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/green"
                app:boxStrokeColor="@color/green_input_color"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/forgotEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/green"
                    android:textCursorDrawable="@drawable/green_cursor" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendResetLinkBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send Reset Link"
                android:textColor="@color/white"
                app:backgroundTint="@color/green"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Step 2: link sent, waiting for the resident to open their mail app -->
        <LinearLayout
            android:id="@+id/linkSentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/linkSentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Check your email for a link to reset your password."
                android:textColor="@color/green"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/linkSentEmailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/linkSentHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Opening the link will bring you straight back here to set a new password. You will still sign in with your username."
                android:textColor="@color/green"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resendResetLinkBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send the Link Again"
                android:textColor="@color/green"
                app:backgroundTint="@color/transparent"
                app:cornerRadius="10dp"
                app:strokeColor="@color/green"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/forgotProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="@color/green" />

        <TextView
            android:id="@+id/backToLoginBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-condensed"
            android:padding="8dp"
            android:text="Back to Login"
            android:textColor="@color/green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
