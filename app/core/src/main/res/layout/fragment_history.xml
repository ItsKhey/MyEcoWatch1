<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->

    <!-- Header with Centered Title, Back Button, and Bulk Actions -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp">

        <!-- Centered History Title -->
        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="History"
            android:textColor="@color/green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Back Button on the Left -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/green" />

        <!-- Bulk Actions on the Right -->
        <LinearLayout
            android:id="@+id/bulkActionsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:text="Select All"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnRestoreBulk"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:visibility="gone"
                app:tint="@color/green" />

            <ImageButton
                android:id="@+id/btnDeleteBulk"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#E53935" />

        </LinearLayout>

    </FrameLayout>


    <!-- Search Bar and Sort -->
    <LinearLayout
        android:id="@+id/searchSortLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/green" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search history..."
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/green"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:autofillHints="none" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/green"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/search_bar_background"
            android:src="@drawable/sort"
            app:tint="@color/green" />
    </LinearLayout>

    <!-- Improved Scrollable Custom Tab Pill Container -->
    <HorizontalScrollView
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabPillContainer"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:background="@drawable/white_pill_background"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="All (0)"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/active_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabSubmitted"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Submitted (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabArchived"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Archived (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabDenied"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Denied (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabRestored"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Restored (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabTrashed"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Trashed (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabDeleted"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Deleted (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabCompleted"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Completed (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabUpdated"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Updated (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/tabTrash"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="100dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Logs Trash (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
